pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- golden: pset on top of spr
function _draw()
  cls(1)
  spr(0, 16, 16)
  pset(19, 19, 7)
  pset(20, 19, 7)
  pset(19, 20, 7)
  pset(20, 20, 7)
  if stat(6)=="headless" then
    extcmd("set_filename", "spr-pset")
    extcmd("screen", 1, 1)
    extcmd("shutdown")
  end
end
