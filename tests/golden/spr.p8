pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- golden: spr / sspr / palt
function _draw()
  cls(1)
  spr(0, 8, 8)
  spr(1, 24, 8)
  spr(2, 40, 8)
  spr(3, 8, 24)
  spr(3, 24, 24, 1, 1, true)
  spr(3, 40, 24, 1, 1, false, true)
  palt(0, false)
  spr(2, 64, 8)
  palt()
  sspr(0, 0, 8, 8, 8, 48, 16, 16)
  sspr(0, 0, 8, 8, 32, 48, 24, 8)
  if stat(6)=="headless" then
    extcmd("set_filename", "spr")
    extcmd("screen", 1, 1)
    extcmd("shutdown")
  end
end
